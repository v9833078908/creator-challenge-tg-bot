diff --git a/view_privacy.go b/view_privacy.go
new file mode 100644
index 0000000..5ffd25b
--- /dev/null
+++ b/view_privacy.go
@@ -0,0 +1,57 @@
+package writefreely
+
+import "net/http"
+
+// View counts are management data, including on otherwise public posts.
+func canReadViewCounts(app *App, r *http.Request, ownerID int64) bool {
+	if u := getUserSession(app, r); u != nil && (u.ID == ownerID || u.IsAdmin()) {
+		return true
+	}
+	u, err := app.db.GetAPIUser(r.Header.Get("Authorization"))
+	return err == nil && u != nil && (u.ID == ownerID || u.IsAdmin())
+}
+
+func viewResponseHeaders(w http.ResponseWriter, allowViews bool) {
+	w.Header().Add("Vary", "Cookie, Authorization")
+	if allowViews {
+		w.Header().Set("Cache-Control", "private, no-store")
+	}
+}
+
+func postForViewer(p *PublicPost, allowViews bool) interface{} {
+	if allowViews {
+		return p
+	}
+	// A shallow response wrapper does not mutate cached posts or stored text.
+	var collection interface{}
+	if p.Collection != nil {
+		collection = collectionForViewer(p.Collection, false)
+	}
+	return struct {
+		*PublicPost
+		Views      *int64      `json:"views,omitempty"`
+		Collection interface{} `json:"collection,omitempty"`
+	}{p, nil, collection}
+}
+
+func collectionForViewer(c *CollectionObj, allowViews bool) interface{} {
+	if allowViews {
+		return c
+	}
+	var posts *[]interface{}
+	if c.Posts != nil {
+		var wrapped []interface{}
+		if *c.Posts != nil {
+			wrapped = make([]interface{}, 0, len(*c.Posts))
+		}
+		for i := range *c.Posts {
+			wrapped = append(wrapped, postForViewer(&(*c.Posts)[i], false))
+		}
+		posts = &wrapped
+	}
+	return struct {
+		*CollectionObj
+		Views *int64         `json:"views,omitempty"`
+		Posts *[]interface{} `json:"posts,omitempty"`
+	}{c, nil, posts}
+}
diff --git a/view_privacy_test.go b/view_privacy_test.go
new file mode 100644
index 0000000..1b63c05
--- /dev/null
+++ b/view_privacy_test.go
@@ -0,0 +1,65 @@
+package writefreely
+
+import (
+	"encoding/json"
+	"net/http/httptest"
+	"strings"
+	"testing"
+)
+
+func TestCreatorViewPrivacy(t *testing.T) {
+	p := &PublicPost{Post: &Post{Content: "7 columns and 123 views are article text"}, Views: 17}
+	coll := &CollectionObj{Collection: Collection{Views: 41}, Posts: &[]PublicPost{*p}}
+	for _, v := range []interface{}{postForViewer(p, false), collectionForViewer(coll, false)} {
+		b, err := json.Marshal(v)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if strings.Contains(string(b), `"views":`) {
+			t.Fatalf("public count leaked: %s", b)
+		}
+		if !strings.Contains(string(b), "123 views") {
+			t.Fatal("article text was changed")
+		}
+	}
+	if p.Views != 17 || coll.Views != 41 {
+		t.Fatal("shared source structs were mutated")
+	}
+	p.Views = 0
+	b, err := json.Marshal(postForViewer(p, true))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(string(b), `"views":0`) {
+		t.Fatalf("owner zero count disappeared: %s", b)
+	}
+}
+
+func TestCreatorViewPrivacyHeaders(t *testing.T) {
+	for _, allow := range []bool{false, true} {
+		w := httptest.NewRecorder()
+		viewResponseHeaders(w, allow)
+		if !strings.Contains(w.Header().Get("Vary"), "Cookie, Authorization") {
+			t.Fatal("missing auth Vary")
+		}
+		if allow && w.Header().Get("Cache-Control") != "private, no-store" {
+			t.Fatal("owner response cacheable")
+		}
+	}
+}
+
+func TestCreatorViewPrivacyCollectionShape(t *testing.T) {
+	empty := []PublicPost{}
+	var nullPosts []PublicPost
+	for _, posts := range []*[]PublicPost{nil, &empty, &nullPosts} {
+		c := &CollectionObj{Posts: posts}
+		original, _ := json.Marshal(c)
+		filtered, _ := json.Marshal(collectionForViewer(c, false))
+		var a, b map[string]json.RawMessage
+		json.Unmarshal(original, &a)
+		json.Unmarshal(filtered, &b)
+		if string(a["posts"]) != string(b["posts"]) {
+			t.Fatalf("posts shape changed: %s -> %s", original, filtered)
+		}
+	}
+}
