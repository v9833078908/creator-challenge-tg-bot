# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-DEF...

# Telegram user id владельца (узнать: @userinfobot)
OWNER_TG_ID=123456789

# --- Дальше дефолты, менять не обязательно ---

# Путь к SQLite (внутри контейнера /app/data)
# DATABASE_URL=sqlite+aiosqlite:///./data/creator_hero.db

# Таймзона челленджа
# CHALLENGE_TIMEZONE=Europe/Moscow

# Дедлайн отчёта (локальное время челленджа)
# REPORT_DEADLINE=23:59

# Минимальная длина текстового поста
# MIN_POST_CHARS=400

# Размер штрафа (руб) и часы на отработку
# PENALTY_AMOUNT_RUB=500
# PENALTY_GRACE_HOURS=24

# Расписание (локальное время челленджа)
# DIGEST_TIME=00:00            # дайджест + выставление штрафов
# REPORT_REMINDER_TIME=21:00   # напоминание несдавшим
# PENALTY_REMINDER_TIME=20:00  # напоминание штрафникам
# KICK_TIME=00:05              # кик просрочивших штрафы
